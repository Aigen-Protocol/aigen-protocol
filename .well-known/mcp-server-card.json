    "homepage": "https://cryptogenesis.duckdns.org",
    "repository": "https://github.com/Aigen-Protocol/aigen-protocol",
    "documentation": "https://cryptogenesis.duckdns.org/AIGEN_PROTOCOL.md",
    "license": "MIT"
  },
