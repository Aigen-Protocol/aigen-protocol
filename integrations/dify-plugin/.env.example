# Local development for the Dify plugin (used by `dify plugin run` / the remote
# debug harness). Copy to `.env` and fill in. These are NOT the plugin's user
# credentials (those are entered in the Dify UI per the provider schema) — they
# point the local runner at a Dify instance for remote debugging.
INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=debug.dify.ai
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=your-dify-debug-key
