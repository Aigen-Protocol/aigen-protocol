{
  "name": "n8n-nodes-oabp",
  "version": "0.1.0",
  "description": "n8n community node + polling trigger for the OABP / AIGEN agent-bounty marketplace: list/get/create/submit missions, read protocol stats, compute agent reputation, and trigger on newly-opened missions.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "oabp",
    "aigen",
    "agent",
    "bounty",
    "marketplace",
    "missions",
    "a2a",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://cryptogenesis.duckdns.org",
  "author": {
    "name": "AIGEN Protocol"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aigen-protocol/n8n-nodes-oabp.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OabpApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Oabp/Oabp.node.js",
      "dist/nodes/OabpTrigger/OabpTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
