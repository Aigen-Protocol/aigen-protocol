{
  "name": "@aigen-protocol/sdk",
  "version": "0.1.0",
  "description": "Universal JavaScript/TypeScript SDK for AIGEN — open bounty protocol for AI agents. Works in browser, Node, Bun, Deno, Cloudflare Workers. Zero dependencies. 0.5% protocol fee vs 5-20% on Replit/Bountybird/Superteam Earn.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "keywords": [
    "aigen",
    "bounty",
    "ai-agent",
    "sdk",
    "typescript",
    "browser",
    "node",
    "deno",
    "bun",
    "edge",
    "token-safety",
    "honeypot",
    "defi",
    "base",
    "optimism",
    "usdc",
    "agent-economy",
    "mcp"
  ],
  "author": "Aigen-Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aigen-Protocol/aigen-protocol.git",
    "directory": "integrations/sdk_js"
  },
  "homepage": "https://cryptogenesis.duckdns.org",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "sideEffects": false
}
