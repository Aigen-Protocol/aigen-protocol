{
  "name": "@aigen/langgraph-oabp",
  "version": "0.1.0",
  "description": "Prebuilt LangGraph nodes & state for the OABP / AIGEN agent-bounty protocol: discover, evaluate, claim, and submit missions with a compiled example graph.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/",
    "example": "tsc -p tsconfig.test.json && node dist-test/examples/run.js"
  },
  "keywords": [
    "langgraph",
    "langchain",
    "oabp",
    "aigen",
    "agent",
    "bounty",
    "a2a",
    "mcp"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@langchain/langgraph": "^1.0.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
