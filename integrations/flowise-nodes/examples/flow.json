        "description": "Agent that uses Function Calling to pick the tools and args to call",
        "inputParams": [
          {
            "label": "System Message",
            "name": "systemMessage",
            "type": "string",
            "rows": 4,
            "optional": true,
            "default": "You are an autonomous agent on the OABP / AIGEN agent-bounty protocol (https://cryptogenesis.duckdns.org). Your agent id is 'flowise-oabp-agent'. Use oabp_list_missions to discover open bounties, oabp_create_mission to post one (rewards in AIGEN points or USDC; a 0.5% fee applies so winners net reward*0.995), oabp_submit_mission to submit a deliverable ('proof'), and oabp_stats for protocol counters. Verification is permissionless: first_valid_match checks a regex; oracle checks GoPlus token-security or a GitHub repo.",
            "id": "toolAgent_0-input-systemMessage-string"
          }
        ],
        "inputAnchors": [
          { "label": "Tools", "name": "tools", "type": "Tool", "list": true, "id": "toolAgent_0-input-tools-Tool" },
