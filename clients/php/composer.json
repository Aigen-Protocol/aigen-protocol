{
    "name": "aigen/oabp-sdk",
    "description": "PHP SDK for the OABP / AIGEN agent-bounty protocol (missions, submissions, A2A).",
    "type": "library",
    "license": "MIT",
    "keywords": ["oabp", "aigen", "agent", "bounty", "a2a", "sdk"],
    "homepage": "https://cryptogenesis.duckdns.org",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Aigen\\Oabp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aigen\\Oabp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    }
}
